        this.cisloSk = cisloSk;
    }

    public  int getVek(){
        return vek;
    }

    public void setVek(int vek){
        if (vek >= 0 && vek<= 100){
            this.vek = vek;
        }
        else{
            System.out.println("Nespravny vek");
        }
    }


    Ziak(int cisloSk , int ISIC , int vek){
        if (vek < 0) {
            System.out.println("VEK NEMOZE BYT NA NULE");
            return;
        }

        this.cisloSk = cisloSk;
        this.ISIC = ISIC;
        this.vek = vek;
    }

    Ziak() {

    }

    public void PrintFormattedZiakInfo(){
        System.out.println("***ziak***");
